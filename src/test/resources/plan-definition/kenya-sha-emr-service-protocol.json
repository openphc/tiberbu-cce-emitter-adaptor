{
  "id": "kenya-sha-emr-service-protocol",
  "url": "http://openphc.org/PlanDefinition/kenya-sha-emr-service-protocol",
  "date": "2026-09-15",
  "name": "KenyaShaEmrServiceProtocol",
  "title": "Kenya SHA NSHR Outpatient Visit Protocol",
  "action": [
    {
      "id": "consent-request",
      "title": "Consent Requested",
      "type": {
        "coding": [
          {
            "system": "http://openphc.org/fhir/CodeSystem/action-type",
            "code": "step"
          }
        ]
      },
      "trigger": [
        {
          "data": [
            {
              "type": "Consent",
              "codeFilter": [
                {
                  "code": [
                    {
                      "code": "proposed"
                    }
                  ],
                  "path": "status"
                },
                {
                  "code": [
                    {
                      "code": "59284-0",
                      "system": "http://loinc.org",
                      "display": "Patient Consent"
                    }
                  ],
                  "path": "category"
                }
              ]
            }
          ],
          "name": "consent-request-trigger",
          "type": "named-event"
        }
      ],
      "description": "Patient-privacy consent proposed but not yet verified. Matches Consent with status proposed (verification[].verified=false, no verificationDate). NSHR/SHR-mediator sample posts this via a Bundle (type=transaction) with a PUT Patient entry alongside the Consent entry - the matcher must unwrap that transaction Bundle to find the Consent resource, not expect a bare Consent payload.",
      "timingTiming": {
        "repeat": {
          "count": 1,
          "period": 1,
          "frequency": 1,
          "periodUnit": "d"
        }
      },
      "requiredBehavior": "must",
      "action": [
        {
          "id": "consent-verification",
          "title": "Consent Verified",
          "type": {
            "coding": [
              {
                "system": "http://openphc.org/fhir/CodeSystem/action-type",
                "code": "step"
              }
            ]
          },
          "trigger": [
            {
              "data": [
                {
                  "type": "Consent",
                  "codeFilter": [
                    {
                      "code": [
                        {
                          "code": "active"
                        }
                      ],
                      "path": "status"
                    },
                    {
                      "code": [
                        {
                          "code": "59284-0",
                          "system": "http://loinc.org",
                          "display": "Patient Consent"
                        }
                      ],
                      "path": "category"
                    }
                  ]
                }
              ],
              "name": "consent-verification-trigger",
              "type": "named-event"
            }
          ],
          "extension": [
            {
              "url": "http://openphc.org/fhir/StructureDefinition/tolerance-days",
              "valueInteger": 1
            }
          ],
          "description": "Consent verified (e.g. via OTP, Afyayangu, or biometrics) - same Consent id transitions status proposed to active, verification[].verified becomes true and verificationDate is set. Sample shows this ~25 minutes after consent-request. Gates access to the patient's SHR record; downstream clinical steps should not be expected before this fires.",
          "timingTiming": {
            "repeat": {
              "count": 1,
              "period": 1,
              "frequency": 1,
              "periodUnit": "d"
            }
          },
          "relatedAction": [
            {
              "actionId": "consent-request",
              "relationship": "after-end",
              "offsetDuration": {
                "code": "d",
                "unit": "d",
                "value": 0,
                "system": "http://unitsofmeasure.org"
              }
            }
          ],
          "requiredBehavior": "must",
          "action": [
            {
              "id": "visit-encounter",
              "title": "Patient Visit",
              "type": {
                "coding": [
                  {
                    "system": "http://openphc.org/fhir/CodeSystem/action-type",
                    "code": "step"
                  }
                ]
              },
              "trigger": [
                {
                  "data": [
                    {
                      "type": "Encounter",
                      "codeFilter": [
                        {
                          "code": [
                            {
                              "code": "AMB",
                              "system": "http://terminology.hl7.org/CodeSystem/v3-ActCode",
                              "display": "ambulatory"
                            }
                          ],
                          "path": "class"
                        }
                      ]
                    }
                  ],
                  "name": "visit-encounter-trigger",
                  "type": "named-event"
                }
              ],
              "description": "Outpatient check-in. Matches Encounter with class AMB (ambulatory). NSHR payloads link this to EpisodeOfCare via Encounter.episodeOfCare rather than a type-coded visit trigger.",
              "timingTiming": {
                "repeat": {
                  "count": 1,
                  "period": 1,
                  "frequency": 1,
                  "periodUnit": "d"
                }
              },
              "relatedAction": [
                {
                  "actionId": "consent-verification",
                  "relationship": "after-end",
                  "offsetDuration": {
                    "code": "d",
                    "unit": "d",
                    "value": 0,
                    "system": "http://unitsofmeasure.org"
                  }
                }
              ],
              "requiredBehavior": "must",
              "action": [
                {
                  "id": "vitals-recording",
                  "title": "Vitals Recording",
                  "type": {
                    "coding": [
                      {
                        "system": "http://openphc.org/fhir/CodeSystem/action-type",
                        "code": "step"
                      }
                    ]
                  },
                  "trigger": [
                    {
                      "data": [
                        {
                          "type": "Observation",
                          "codeFilter": [
                            {
                              "code": [
                                {
                                  "code": "vital-signs",
                                  "system": "http://terminology.hl7.org/CodeSystem/observation-category",
                                  "display": "Vital Signs"
                                }
                              ],
                              "path": "category"
                            }
                          ]
                        }
                      ],
                      "name": "vitals-trigger",
                      "type": "named-event"
                    }
                  ],
                  "extension": [
                    {
                      "url": "http://openphc.org/fhir/StructureDefinition/tolerance-days",
                      "valueInteger": 1
                    }
                  ],
                  "description": "Vitals bundle (temp, HR, RR, height, weight, BMI, SpO2, systolic/diastolic BP), one Observation per vital sharing a common effectiveDateTime. NSHR payloads emit these under a distinct sub-Encounter from the visit Encounter, and may arrive a day or more after visit-encounter for this data source - hence the wider tolerance. Optional (could): per the Sept 2026 Kenya PlanDefinition follow-up, Triage (vitals) depends on clinical/administrative choice - only Registration and Consent are unconditionally mandatory, with diagnosis becoming mandatory once the patient reaches consultation.",
                  "timingTiming": {
                    "repeat": {
                      "count": 1,
                      "period": 1,
                      "frequency": 1,
                      "periodUnit": "d"
                    }
                  },
                  "relatedAction": [
                    {
                      "actionId": "visit-encounter",
                      "relationship": "after-start",
                      "offsetDuration": {
                        "code": "d",
                        "unit": "d",
                        "value": 0,
                        "system": "http://unitsofmeasure.org"
                      }
                    }
                  ],
                  "requiredBehavior": "could"
                },
                {
                  "id": "diagnosis",
                  "title": "Clinical Diagnosis",
                  "type": {
                    "coding": [
                      {
                        "system": "http://openphc.org/fhir/CodeSystem/action-type",
                        "code": "step"
                      }
                    ]
                  },
                  "trigger": [
                    {
                      "data": [
                        {
                          "type": "Condition"
                        }
                      ],
                      "name": "diagnosis-trigger",
                      "type": "named-event"
                    }
                  ],
                  "extension": [
                    {
                      "url": "http://openphc.org/fhir/StructureDefinition/tolerance-days",
                      "valueInteger": 1
                    }
                  ],
                  "description": "Diagnosis recorded. Matches any Condition (resource-type only). NSHR Condition.clinicalStatus/verificationStatus values (e.g. inactive/provisional) don't reliably indicate an active new diagnosis for this source, so codeFilter is intentionally omitted rather than mismatched.",
                  "timingTiming": {
                    "repeat": {
                      "count": 1,
                      "period": 1,
                      "frequency": 1,
                      "periodUnit": "d"
                    }
                  },
                  "relatedAction": [
                    {
                      "actionId": "vitals-recording",
                      "relationship": "after-end",
                      "offsetDuration": {
                        "code": "d",
                        "unit": "d",
                        "value": 0,
                        "system": "http://unitsofmeasure.org"
                      }
                    }
                  ],
                  "requiredBehavior": "must"
                },
                {
                  "id": "medication-request",
                  "title": "Medication Order",
                  "type": {
                    "coding": [
                      {
                        "system": "http://openphc.org/fhir/CodeSystem/action-type",
                        "code": "step"
                      }
                    ]
                  },
                  "trigger": [
                    {
                      "data": [
                        {
                          "type": "MedicationRequest",
                          "codeFilter": [
                            {
                              "code": [
                                {
                                  "code": "active"
                                }
                              ],
                              "path": "status"
                            },
                            {
                              "code": [
                                {
                                  "code": "outpatient",
                                  "system": "http://terminology.hl7.org/CodeSystem/medicationrequest-category",
                                  "display": "Outpatient"
                                }
                              ],
                              "path": "category"
                            }
                          ]
                        }
                      ],
                      "name": "medication-request-trigger",
                      "type": "named-event"
                    }
                  ],
                  "extension": [
                    {
                      "url": "http://openphc.org/fhir/StructureDefinition/tolerance-days",
                      "valueInteger": 1
                    }
                  ],
                  "description": "Medication prescribed. Matches MedicationRequest with status active and category outpatient (medicationReference itself is deliberately not filtered on - it would restrict this to one specific drug rather than any medication order). Optional (could): not every diagnosis leads to a prescription (advice-only visits, referrals, lab-only visits) - medication-dispense/medication-administration remain must, since once a medication genuinely is requested, tracking whether it's dispensed and administered is a real compliance concern. Note: observed sample data has MedicationDispense.whenHandedOver preceding this request's dispenseRequest.validityPeriod.start by ~1.5 minutes - a likely source data-quality issue, not a protocol design choice.",
                  "timingTiming": {
                    "repeat": {
                      "count": 1,
                      "period": 1,
                      "frequency": 1,
                      "periodUnit": "d"
                    }
                  },
                  "relatedAction": [
                    {
                      "actionId": "diagnosis",
                      "relationship": "after-end",
                      "offsetDuration": {
                        "code": "d",
                        "unit": "d",
                        "value": 0,
                        "system": "http://unitsofmeasure.org"
                      }
                    }
                  ],
                  "requiredBehavior": "could",
                  "action": [
                    {
                      "id": "medication-dispense",
                      "title": "Medication Dispense",
                      "type": {
                        "coding": [
                          {
                            "system": "http://openphc.org/fhir/CodeSystem/action-type",
                            "code": "step"
                          }
                        ]
                      },
                      "trigger": [
                        {
                          "data": [
                            {
                              "type": "MedicationDispense",
                              "codeFilter": [
                                {
                                  "code": [
                                    {
                                      "code": "completed"
                                    }
                                  ],
                                  "path": "status"
                                }
                              ]
                            }
                          ],
                          "name": "medication-dispense-trigger",
                          "type": "named-event"
                        }
                      ],
                      "extension": [
                        {
                          "url": "http://openphc.org/fhir/StructureDefinition/tolerance-days",
                          "valueInteger": 1
                        }
                      ],
                      "description": "Medication dispensed to patient. Matches completed MedicationDispense. Links back via authorizingPrescription to medication-request.",
                      "timingTiming": {
                        "repeat": {
                          "count": 1,
                          "period": 1,
                          "frequency": 1,
                          "periodUnit": "d"
                        }
                      },
                      "relatedAction": [
                        {
                          "actionId": "medication-request",
                          "relationship": "after-end",
                          "offsetDuration": {
                            "code": "d",
                            "unit": "d",
                            "value": 0,
                            "system": "http://unitsofmeasure.org"
                          }
                        }
                      ],
                      "requiredBehavior": "could",
                      "action": [
                        {
                          "id": "medication-administration",
                          "title": "Medication Administration",
                          "type": {
                            "coding": [
                              {
                                "system": "http://openphc.org/fhir/CodeSystem/action-type",
                                "code": "step"
                              }
                            ]
                          },
                          "trigger": [
                            {
                              "data": [
                                {
                                  "type": "MedicationAdministration",
                                  "codeFilter": [
                                    {
                                      "code": [
                                        {
                                          "code": "completed"
                                        }
                                      ],
                                      "path": "status"
                                    }
                                  ]
                                }
                              ],
                              "name": "medication-administration-trigger",
                              "type": "named-event"
                            }
                          ],
                          "extension": [
                            {
                              "url": "http://openphc.org/fhir/StructureDefinition/tolerance-days",
                              "valueInteger": 1
                            }
                          ],
                          "description": "Medication administered to patient. Matches completed MedicationAdministration. Sample NSHR payload has no effectiveDateTime/effectivePeriod, so its actual completion time cannot be verified from the payload alone - only inferred as after dispense.",
                          "timingTiming": {
                            "repeat": {
                              "count": 1,
                              "period": 1,
                              "frequency": 1,
                              "periodUnit": "d"
                            }
                          },
                          "relatedAction": [
                            {
                              "actionId": "medication-dispense",
                              "relationship": "after-end",
                              "offsetDuration": {
                                "code": "d",
                                "unit": "d",
                                "value": 0,
                                "system": "http://unitsofmeasure.org"
                              }
                            }
                          ],
                          "requiredBehavior": "could"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "lab-order-request",
                  "title": "Lab Order",
                  "type": {
                    "coding": [
                      {
                        "system": "http://openphc.org/fhir/CodeSystem/action-type",
                        "code": "step"
                      }
                    ]
                  },
                  "trigger": [
                    {
                      "data": [
                        {
                          "type": "ServiceRequest",
                          "codeFilter": [
                            {
                              "code": [
                                {
                                  "code": "108252007",
                                  "system": "http://snomed.info/sct",
                                  "display": "Laboratory procedure"
                                }
                              ],
                              "path": "category"
                            },
                            {
                              "code": [
                                {
                                  "code": "active"
                                }
                              ],
                              "path": "status"
                            }
                          ]
                        }
                      ],
                      "name": "lab-order-request-trigger",
                      "type": "named-event"
                    }
                  ],
                  "extension": [
                    {
                      "url": "http://openphc.org/fhir/StructureDefinition/tolerance-days",
                      "valueInteger": 1
                    }
                  ],
                  "description": "Lab test ordered. Matches ServiceRequest with status active and category 108252007 (Laboratory procedure) - distinguishes a lab order from a procedure order, which uses category 387713003 instead. Optional: not every visit includes a lab order. Only the order stage is modeled here - no sample payload yet exists for the test-execution/result-generation/result-verification stages of the lab workflow.",
                  "timingTiming": {
                    "repeat": {
                      "count": 1,
                      "period": 1,
                      "frequency": 1,
                      "periodUnit": "d"
                    }
                  },
                  "relatedAction": [
                    {
                      "actionId": "diagnosis",
                      "relationship": "after-end",
                      "offsetDuration": {
                        "code": "d",
                        "unit": "d",
                        "value": 0,
                        "system": "http://unitsofmeasure.org"
                      }
                    }
                  ],
                  "requiredBehavior": "could"
                },
                {
                  "id": "procedure-order-request",
                  "title": "Procedure Order",
                  "type": {
                    "coding": [
                      {
                        "system": "http://openphc.org/fhir/CodeSystem/action-type",
                        "code": "step"
                      }
                    ]
                  },
                  "trigger": [
                    {
                      "data": [
                        {
                          "type": "ServiceRequest",
                          "codeFilter": [
                            {
                              "code": [
                                {
                                  "code": "387713003",
                                  "system": "http://snomed.info/sct",
                                  "display": "Surgical procedure"
                                }
                              ],
                              "path": "category"
                            },
                            {
                              "code": [
                                {
                                  "code": "active"
                                }
                              ],
                              "path": "status"
                            }
                          ]
                        }
                      ],
                      "name": "procedure-order-request-trigger",
                      "type": "named-event"
                    }
                  ],
                  "extension": [
                    {
                      "url": "http://openphc.org/fhir/StructureDefinition/tolerance-days",
                      "valueInteger": 1
                    }
                  ],
                  "description": "Procedure ordered. Matches ServiceRequest with status active and category 387713003 (Surgical procedure) - distinguishes a procedure order from a lab order, which uses category 108252007 instead. Optional: not every visit includes a procedure order. Sample order and sample completion (see procedure below) are unrelated mock payloads for different patients/encounters, not a linked pair - the relatedAction/tolerance below expresses the expected real-world sequencing, not something inferred from those samples.",
                  "timingTiming": {
                    "repeat": {
                      "count": 1,
                      "period": 1,
                      "frequency": 1,
                      "periodUnit": "d"
                    }
                  },
                  "relatedAction": [
                    {
                      "actionId": "diagnosis",
                      "relationship": "after-end",
                      "offsetDuration": {
                        "code": "d",
                        "unit": "d",
                        "value": 0,
                        "system": "http://unitsofmeasure.org"
                      }
                    }
                  ],
                  "requiredBehavior": "could",
                  "action": [
                    {
                      "id": "procedure",
                      "title": "Therapeutic Procedure",
                      "type": {
                        "coding": [
                          {
                            "system": "http://openphc.org/fhir/CodeSystem/action-type",
                            "code": "step"
                          }
                        ]
                      },
                      "trigger": [
                        {
                          "data": [
                            {
                              "type": "Procedure",
                              "codeFilter": [
                                {
                                  "code": [
                                    {
                                      "code": "THERAPEUTIC-PROCEDURE",
                                      "system": "https://nshr-uat.sha.go.ke/fhir/CodeSystem/procedure-code-cs"
                                    }
                                  ],
                                  "path": "code"
                                },
                                {
                                  "code": [
                                    {
                                      "code": "completed"
                                    }
                                  ],
                                  "path": "status"
                                }
                              ]
                            }
                          ],
                          "name": "procedure-trigger",
                          "type": "named-event"
                        }
                      ],
                      "extension": [
                        {
                          "url": "http://openphc.org/fhir/StructureDefinition/tolerance-days",
                          "valueInteger": 1
                        }
                      ],
                      "description": "Therapeutic procedure performed (e.g. wound cleaning). Matches Procedure with code THERAPEUTIC-PROCEDURE and status completed - not every visit includes a procedure, so this is optional. Sample payload lists the same performer twice in Procedure.performer - likely a source duplication, not two distinct performers. Links back conceptually to procedure-order-request, though the sample order/completion payloads are unrelated mock data rather than an actual linked pair.",
                      "timingTiming": {
                        "repeat": {
                          "count": 1,
                          "period": 1,
                          "frequency": 1,
                          "periodUnit": "d"
                        }
                      },
                      "relatedAction": [
                        {
                          "actionId": "procedure-order-request",
                          "relationship": "after-end",
                          "offsetDuration": {
                            "code": "d",
                            "unit": "d",
                            "value": 0,
                            "system": "http://unitsofmeasure.org"
                          }
                        }
                      ],
                      "requiredBehavior": "could"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "status": "active",
  "version": "1.0.0",
  "description": "Tracks a Kenya SHA/NSHR outpatient visit workflow: patient-privacy consent request/verification (Consent status proposed then active), ambulatory check-in (Encounter class=AMB), vitals recording, diagnosis, medication order/dispense/administration, and an optional therapeutic procedure. Sample payload shows each step's Observation/Condition/Medication*/Procedure resources referencing distinct Encounter ids rather than one shared visit Encounter - the Matcher Service should correlate by patient/episode, not by a single Encounter id, for this data source.",
  "resourceType": "PlanDefinition"
}
